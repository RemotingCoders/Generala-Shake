# Copy to .env.local (local dev) or set in Vercel → Settings → Environment Variables.
# Without SUPABASE_* the API uses an in-memory store (local only, no Realtime).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Optional: public base URL encoded in the QR (default: derived from the request host)
PUBLIC_URL=
# Narrator voice (GET /api/tts, OpenAI gpt-4o-mini-tts). Without it /api/tts answers 503 and the TV stays silent.
OPENAI_API_KEY=
# Optional: OPENAI_TTS_VOICE (default ash), OPENAI_TTS_MODEL (default gpt-4o-mini-tts)
